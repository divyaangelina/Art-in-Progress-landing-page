# Copy this file to .env.local and fill in the real value.
# .env.local is gitignored — never commit a real key.
#
# Used only by api/waitlist.js, which runs on the server. It is deliberately
# NOT prefixed with VITE_: Vite inlines every VITE_* variable into the
# browser bundle, which would publish the key to every visitor.

BUTTONDOWN_API_KEY=
